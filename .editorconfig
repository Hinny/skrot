root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120

# ktlint runs in CI as a targeted gate, not a formatter. Everything is off
# except the checks that catch code which has stopped meaning anything —
# reformatting the whole codebase to satisfy a style rule would bury real
# review signal under whitespace.
ktlint_standard = disabled
ktlint_experimental = disabled
ktlint_standard_no-unused-imports = enabled
ktlint_standard_no-wildcard-imports = enabled

[*.{yml,yaml,toml}]
indent_size = 2

[*.xml]
indent_size = 4
